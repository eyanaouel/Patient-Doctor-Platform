{% extends 'base.html.twig' %}

{% block title %}Page d'accueil{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Poppins', 'Arial', sans-serif;
            background-color: #f9f9f9;
            color: #4a4a4a;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            height: 100vh; /* Utilisation de la hauteur totale de la fenêtre */
        }

        header {
            background-color: #80005d;
            color: #ffffff;
            padding: 15px 0;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            margin: 0;
            font-size: 1.8rem;
            font-weight: bold;
        }

        header nav a {
            color: white;
            margin-left: 15px;
            text-decoration: none;
            font-size: 1.1rem;
        }

        header nav a:hover {
          /*  text-decoration: underline;*/
            font-weight: bold;
        }

        footer {
            background-color: #80005d;
            color: white;
            padding: 15px 0;
            text-align: center;
            margin-top: 20px;
            margin-bottom: 0; /* Assure que le footer reste en bas */
        }

        main {
            text-align: center;
            margin: 20px 0;
            flex-grow: 1; /* Fait en sorte que le contenu prenne toute la place disponible */
        }

        main p {
            font-size: 2.5rem;
            color: #4a4a4a;
            font-family: 'Montserrat';
            font-weight: bold; 
        }

        main img {
            width: 100%; 
            height: auto; 
            display: block; 
            margin: 0 auto; 
        }

        .container {
            margin-top: 20px;
            text-align: center;
        }

        .container a {
            text-decoration: none;
            
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 1.1rem;
            margin: 5px;
        }

        .container a:hover {
            
        }

        .container ul {
            list-style: none;
            padding: 0;
        }

        .container ul li {
            display: inline-block;
            margin-right: 20px;
        }

        .container ul li a {
           /* color: #ff66b2;*/
            font-weight: bold;
            text-decoration: none;
        }

        .container ul li a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
<header>
    <div class="container">
        <h1>{{ title }}</h1>
        <nav>
                <a href="{{ path('app_register', {type: 'medecin'}) }}">S'inscrire comme Médecin</a>
                <a href="{{ path('app_register', {type: 'patient'}) }}">S'inscrire comme Patient</a>
                <a href="{{ path('app_login') }}">Se connecter</a>
            
        </nav>
    </div>
</header>

<main>
    <p>Prenez rapidement un rendez-vous avec votre médecin !</p> 
    <img src="{{ asset('images/medecins.png') }}" alt="Medecins">
</main>

<footer>
    <p>© Copyright 2025 Health.tn Tous droits réservés</p>
</footer>
{% endblock %}
