{% extends 'base.html.twig' %}

{% block title %}Ajouter un Médecin{% endblock %}

{% block body %}
    <h1>Ajouter un Médecin</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.specialite) }}
        <button type="submit">Ajouter</button>
    {{ form_end(form) }}

    <a href="{{ path('medecin_index') }}">Retour à la liste</a>
{% endblock %}
