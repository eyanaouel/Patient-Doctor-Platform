{% extends 'base.html.twig' %}

{% block title %}Liste des Médecins{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Poppins', 'Arial', sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 0;
            color: #333;
        }

        .container {
            max-width: 900px;
            margin: 50px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            font-size: 2rem;
            color: #4a4a4a;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background-color: #fdfdfd;
        }

        table th, table td {
            padding: 10px 15px;
            text-align: left;
            border: 1px solid #ddd;
        }

        table th {
            background-color: #80005d;
            color: #fff;
        }

        table tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        a {
            text-decoration: none;
            color: #80005d;
            font-weight: bold;
        }

        a:hover {
            text-decoration: underline;
        }

        .actions a {
            margin-right: 10px;
        }

        .add-button {
            display: block;
            width: fit-content;
            margin: 20px auto;
            padding: 10px 15px;
            background-color: #80005d;
            color: #fff;
            text-align: center;
            border-radius: 5px;
            font-weight: bold;
        }

        .add-button:hover {
            background-color: #80005d;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Liste des Médecins</h1>

        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Spécialité</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for medecin in medecins %}
                    <tr>
                        <td>{{ medecin.nom }}</td>
                        <td>{{ medecin.specialite }}</td>
                        <td class="actions">
                            <a href="{{ path('medecin_edit', {'id': medecin.id}) }}">Modifier</a>
                            <a href="{{ path('medecin_delete', {'id': medecin.id}) }}" 
                               onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce médecin ?')">Supprimer</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">Aucun médecin trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('medecin_new') }}" class="add-button">Ajouter un médecin</a>
    </div>
{% endblock %}
