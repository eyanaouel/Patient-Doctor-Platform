{% extends 'base.html.twig' %}

{% block title %}Détails Patient{% endblock %}

{% block body %}
    <div class="container mt-4">
        <a href="{{ path('medecin_dashboard') }}" class="btn btn-secondary mb-3">Retour</a>
        
        <div class="card mb-4">
            <div class="card-body">
                <h4>Informations Patient</h4>
                <p><strong>Nom:</strong> {{ patient.nom }}</p>
                <p><strong>Prénom:</strong> {{ patient.prenom }}</p>
                <p><strong>CNAM:</strong> {{ patient.numCNAM }}</p>
                <p><strong>Date de Naissance:</strong> {{ patient.dateNaissance|date('d/m/Y') }}</p>
                <p><strong>Groupe Sanguin:</strong> {{ patient.groupeSanguin }}</p>
            </div>
        </div>

        
{% endblock %} 