{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Patient{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Poppins', 'Arial', sans-serif;
            background-color: #f9f9f9;
            color: #4a4a4a;
            margin: 0;
            padding: 0;
        }

        /* Header Styles */
        header {
            background-color: #80005d;
            color: white;
            padding: 20px 0;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            color: white;
            margin: 0;
            font-size: 2rem;
            font-weight: bold;
        }

        header nav a {
            color: white;
            margin-left: 20px;
            text-decoration: none;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        header nav a:hover {
          
            font-weight: bold;
        }

        /* Footer Styles */
        footer {
            background-color: #80005d;
            color: white;
            padding: 15px 0;
            text-align: center;
            margin-top: 20px;
        }

        /* Main Content Styles */
        .container {
            margin-top: 20px;
        }

        h1 {
            font-size: 2rem;
            font-weight: bold;
            color: #d63384;
            text-align: center;
        }

        .btn-primary {
            background-color: #80005d;
            border-color: #80005d;
            font-weight: bold;
        }

        .btn-primary:hover {
            background-color: #80005d;
            border-color: #80005d;
        }

        .medecin-card {
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
        }

        .medecin-card .card {
            border: none;
            border-radius: 8px;
        }

        .medecin-card .card-body {
            padding: 15px;
        }

        .medecin-card .card-title {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .medecin-card .card-text {
            font-size: 14px;
            margin-bottom: 10px;
        }

        .medecin-card .btn {
            background-color: #80005d;
        }

        .medecin-card .btn:hover {
            background-color: #80005d;
        }

        /* Search Bar */
        #searchMedecin {
            width: 100%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .list-group-item {
            border: 1px solid #ffe6f2;
            border-radius: 8px;
            background-color: white;
            margin-bottom: 10px;
            padding: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .list-group-item a {
            text-decoration: none;
            color: #d63384;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .list-group-item a:hover {
            text-decoration: underline;
        }

    </style>
{% endblock %}

{% block body %}
<header>
    <div class="container">
        <h1>Tableau de bord - Patient</h1>
        <nav>
            <a href="{{ path('patient_compte') }}">Mon compte</a>
            <a href="{{ path('patient_mes_rdv') }}">Mes RDVs</a>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        </nav>
    </div>
</header>

<div class="container mt-4">
    <h1>Bienvenue, {{ app.user.nom }}</h1>

 {#    Gérer mon compte et RDVs
    <a href="{{ path('patient_compte') }}" class="btn btn-primary">Gérer mon compte</a>
    <a href="{{ path('patient_mes_rdv') }}" class="btn btn-primary">Mes RDVs</a> #}

    <div class="mt-4">
        <h2>Liste des Médecins</h2>

        <div class="mb-4">
            <input type="text" id="searchMedecin" class="form-control" placeholder="Rechercher un médecin...">
        </div>

        <div class="row">
            {% for medecin in medecins %}
                <div class="col-md-4 mb-4 medecin-card">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Dr. {{ medecin.nom }} {{ medecin.prenom }}</h5>
                            <p class="card-text">
                                <strong>Spécialité:</strong> {{ medecin.specialite }}
                            </p>
                            <a href="{{ path('patient_voir_medecin', {'id': medecin.id}) }}" 
                               class="btn btn-primary">Voir détails</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<footer>
    <div class="container">
        © Copyright 2025 Health.tn Tous droits réservés
    </div>
</footer>

<script>
    document.getElementById('searchMedecin').addEventListener('keyup', function() {
        const search = this.value.toLowerCase();
        document.querySelectorAll('.medecin-card').forEach(card => {
            const text = card.textContent.toLowerCase();
            card.style.display = text.includes(search) ? '' : 'none';
        });
    });
</script>

{% endblock %}
