{% extends 'base.html.twig' %}

{% block title %}Dr. {{ medecin.nom }} {{ medecin.prenom }}{% endblock %}

{% block body %}
<style>
    body {
        font-family: 'Poppins', 'Arial', sans-serif;
        background-color: #f9f9f9;
        color: #4a4a4a;
        margin: 0;
        padding: 0;
    }

    header {
        background-color:#80005d;
        color: #ffffff;
        padding: 15px 0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    header .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    header h1 {
        color: white;
        margin: 0;
        font-size: 1.8rem;
        font-weight: bold;
    }

    header nav a {
        color: white;
        margin-left: 15px;
        text-decoration: none;
        font-size: 1.1rem;
    }

    header nav a:hover {
        text-decoration: underline;
        font-weight: bold;
    }

    footer {
        background-color: #80005d;
        color: white;
        padding: 15px 0;
        text-align: center;
        margin-top: 20px;
    }

    .container {
        margin-top: 20px;
    }

    h1 {
        font-size: 2rem;
        font-weight: bold;
        color: #d63384;
        text-align: center;
    }

    .card {
        border: 1px solid #ffe6f2;
        border-radius: 8px;
        background-color: white;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .card-body {
        padding: 20px;
    }

    h3 {
        font-size: 1.5rem;
        color: #4a4a4a;
    }

    .btn {
        border-radius: 20px;
        font-weight: bold;
    }

    .btn-primary {
        background-color: #80005d;
        border-color: #80005d;
    }

    .btn-primary:hover {
        background-color: #80005d;
        border-color: #80005d;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #fff;
    }

    .btn-warning:hover {
        background-color: #e0a800;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .btn-danger:hover {
        background-color: #c82333;
    }

    input[type="file"] {
        border: 1px solid #ddd;
        padding: 10px;
        border-radius: 5px;
    }
</style>

<header>
    <div class="container">
        <h1>Gestion des Dossiers</h1>
        <nav>
            <a href="{{ path('medecin_dashboard') }}">Dashboard</a>
            <a href="{{ path('medecin_compte') }}">Mon Compte</a>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        </nav>
    </div>
</header>

<div class="container">
    <h1>Dr. {{ medecin.nom }} {{ medecin.prenom }}</h1>

    <div class="card">
        <div class="card-body">
            <h3>Informations sur le médecin</h3>
            <p><strong>Spécialité:</strong> {{ medecin.specialite }}</p>
            <p><strong>Disponibilités:</strong> {# {{ medecin.disponibilite }} #}</p>
            <p><strong>Numéro professionnel:</strong> {{ medecin.numeroPro }}</p>
        </div>
    </div>

    <a href="{{ path('patient_rdv_new', {'id': medecin.id}) }}" class="btn btn-primary">Prendre rendez-vous</a>

    <br><br>
    <a href="{{ path('patient_dashboard') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Retour au tableau de bord
    </a>
</div> <br><br><br><br><br>

<footer>
    <p>© Copyright 2025 Health.tn Tous droits réservés</p>
</footer>
{% endblock %}
